# Optional hosted LLM API (OpenAI-compatible); key remains server-side
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# REQUIRED for production: use a long random secret, never commit real secrets
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_PATH=hcm_lite.db
PORT=5000
APP_TIMEZONE=Asia/Karachi
COOKIE_SECURE=0
# Optional: set BOTH to provision first Admin automatically; otherwise use /first-run
ADMIN_EMAIL=
ADMIN_PASSWORD=
